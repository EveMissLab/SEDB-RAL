{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sedb-ral:public-claim:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "display_label", "role_description", "continuity_claim", "public_registration_opt_in", "addresses", "evidence_refs"],
  "properties": {
    "schema": {"const": "sedb-ral.public-claim/0.1"},
    "display_label": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"},
    "role_description": {"type": "string", "maxLength": 1000},
    "continuity_claim": {"enum": ["new", "uncertain"]},
    "public_registration_opt_in": {"const": true},
    "addresses": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/address"}},
    "evidence_refs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
  },
  "$defs": {
    "address": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "identifier_kind", "locator"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]{0,63}$"},
        "identifier_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]{0,63}$"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"}
      }
    }
  }
}
